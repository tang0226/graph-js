{
  "name": "@tang0226/graph-js",
  "version": "0.8.0",
  "description": "Physics-based graph library with canvas rendering and headless simulation layer",
  "keywords": [
    "graph",
    "network",
    "force-directed",
    "layout",
    "canvas",
    "visualization"
  ],
  "homepage": "https://github.com/tang0226/graph-js#readme",
  "bugs": {
    "url": "https://github.com/tang0226/graph-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tang0226/graph-js.git"
  },
  "license": "MIT",
  "author": "Toby Ang",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./graph": {
      "types": "./types/graph.d.ts",
      "default": "./src/graph.js"
    },
    "./simulation": {
      "types": "./types/simulation.d.ts",
      "default": "./src/simulation.js"
    },
    "./renderer": {
      "types": "./types/renderer.d.ts",
      "default": "./src/renderer.js"
    },
    "./tween": {
      "types": "./types/tween.d.ts",
      "default": "./src/tween.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "tsc -p tsconfig.json",
    "types": "node -e \"fs.rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.types.json",
    "test:types": "npm run types && tsc -p test-types/tsconfig.json && tsc -p test-types/tsconfig.headless.json",
    "prepublishOnly": "npm test && npm run test:types"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
